<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drive</title>
</head>
<body>
    <div class="FileDetail">
        <h2>Filename : <%=filedetail[0].filename %> </h2>
        <h2>Uploader : <%= Owner %></h2>
        <h2>Time : <%=filedetail[0].time %></h2>
        <h2>Size : <%=filedetail[0].size  %> Bytes</h2>
        <form action="drive/downloadfile" method="post">
            <button>Download File</button>
        </form>
    </div>
</body>
</html>