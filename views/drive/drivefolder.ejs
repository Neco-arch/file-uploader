<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drive</title>
</head>
<body>
    <%- include('../component/side-bar') %>
    <main>
        <h1><%= folder.name %></h1>
        <button class="Upload_file">Upload file</button>
        <div class="Folder">
            <% Files.forEach(item => { %>
                <form action="/drive/viewfolder" method="post">
                    <h2><%=item.foldername %></h2>
                    <input type="hidden" value="<%=item.foldername %>" name="foldername">
                    <button type="submit">View Folder</button>
                </form>
            <% }) %>
        </div>
    </main>


    <dialog id="UploadFile_Form">
        <% if (locals.user) { %>
            <form action="/drive/upload" method="post" enctype="multipart/form-data">
                <label>File : </label><input type="file" name="fileupload" >
                <input type="hidden" name="Uploader" value="<%= user.username %>">
                <input type="hidden" name="Uploader_id" value="<%= user.id %>">
                <button type="submit">Upload file</button>
            </form>
            <button class="Cancel_UploadFile">Cancel</button>
        <% } %>
    </dialog>

    <script>
        const UploadForm = document.querySelector("#UploadFile_Form")

        document.querySelector(".Upload_file").addEventListener("click" , () => {
            UploadForm.showModal()
        })

        document.querySelector(".Cancel_UploadFile").addEventListener("click" , () => {
            UploadForm.close()
        })
    </script>
</body>
</html>