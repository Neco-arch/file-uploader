<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drive</title>
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/drive.css">
</head>

<body>
    <%- include('../component/side-bar') , { user: user } %>
        <main>
            <h1>WELCOME BACK <%= user.username %>
            </h1>
            <div class="Create_wrapper">
                <button class="Upload_file">Upload file</button>
                <button class="Create_Folder">Create folder</button>
            </div>
            <div class="Folder">
                <% items.forEach(item=> { %>
                    <div class="Each_folder">
                        <h2>
                            <%=item.foldername %>
                        </h2>
                        <div class="Action">
                            <form action="/drive/viewfolder" method="post">
                                <input type="hidden" value="<%=item.foldername %>" name="foldername">
                                <input type="hidden" value="<%=item.id %>" name="folderid">
                                <button type="submit">View Folder</button>
                            </form>
                            <form action="/drive/deletefolder" method="post">
                                <input type="hidden" value="<%=item.foldername %>" name="foldername">
                                <input type="hidden" value="<%=item.id %>" name="folderid">
                                <button type="submit">Delete Folder</button>
                            </form>
                            <button class="editfolder">Edit folder</button>
                            <dialog id="editfolderform_id">
                                <form action="/drive/editfolder" method="post">
                                    <input type="hidden" value="<%=item.id  %>" name="folderid">
                                    <input type="hidden" value="<%=item.foldername%>" name="foldername">
                                    <label>Filename : </label><input type="text" name="newfoldername"
                                        value="<%=item.foldername%>">
                                    <button type="submit">Edit file</button>
                                </form>
                                <button class="Close_edit_form">Close</button>
                            </dialog>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <div class="file">
                <% files.forEach(file=> { %>
                    <div class="each_files">
                        <h2>
                            <%=file.filename%>
                        </h2>
                        <div class="Action">
                        <form action="/drive/viewfile" method="post">
                            <input type="hidden" value="<%=file.filename%>" name="filename">
                            <input type="hidden" value="<%=user.id%>" name="Userid">
                            <button type="submit">View File</button>
                        </form>
                        <form action="/drive/deletefile" method="post">
                            <input type="hidden" value="<%=file.fileid   %>" name="fileid">
                            <input type="hidden" value="<%=file.filename%>" name="filename">
                            <button type="submit">Delete File</button>
                        </form>
                        <button class="Editfile">Edit file</button>
                        <dialog id="editform_id">
                            <form action="/drive/editfile" method="post">
                                <input type="hidden" value="<%=file.fileid   %>" name="fileid">
                                <input type="hidden" value="<%=file.filename%>" name="filename">
                                <label>Filename : </label><input type="text" name="newfilename"
                                    value="<%=file.filename%>">
                                <button type="submit">Edit file</button>
                            </form>
                            <button class="Close_edit">Close</button>
                        </dialog>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </main>


        <dialog id="UploadFile_Form">
            <% if (locals.user) { %>
                <form action="/drive/upload" method="post" enctype="multipart/form-data">
                    <label>File : </label><input type="file" name="fileupload">
                    <input type="hidden" name="Uploader" value="<%= user.username %>">
                    <input type="hidden" name="Uploader_id" value="<%= user.id %>">
                    <button type="submit">Upload file</button>
                </form>
                <button class="Cancel_UploadFile">Cancel</button>
                <% } %>
        </dialog>

        <dialog id="CreateFolder_Form">
            <% if (locals.user) { %>
                <form action="/drive/createfolder" method="post">
                    <label>FolderName :</label><input type="text" name="foldername">
                    <input type="hidden" name="Uploader_id" value="<%= user.id %>">
                    <button type="submit">Create Folder</button>
                </form>
                <button class="CancelCreateFolder">Cancel</button>
                <% } %>
        </dialog>

        <script src="/js/drivepage.js"></script>
</body>

</html>